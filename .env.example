# Hack Club Auth OAuth application credentials.
# Register an app under "Developer Apps" at https://auth.hackclub.com and paste them here.
HCA_CLIENT_ID=your_client_id
HCA_CLIENT_SECRET=your_client_secret

# Must EXACTLY match the redirect URI registered on your HCA app.
# For local dev: http://localhost:5173/auth/callback
HCA_REDIRECT_URI=http://localhost:5173/auth/callback

# Base URL of the Hack Club Auth server. You almost never need to change this.
HCA_ISSUER=https://auth.hackclub.com

# Comma-separated list of admin email addresses, matched (case-insensitively)
# against the email returned by Hack Club Auth.
ADMIN_EMAILS=teacher@example.com

# Where the SQLite database and uploaded item images live (created automatically).
DATABASE_URL=./data/shop.db
UPLOADS_DIR=./data/uploads

# DEV ONLY: set to 1 to skip Hack Club Auth entirely and act as an admin
# ("dev@localhost"). Only honored by `bun run dev`; production builds ignore it.
DEV_BYPASS_AUTH=0
